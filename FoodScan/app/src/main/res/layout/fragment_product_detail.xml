<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/food_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBackProduct" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="38dp" android:text="← Назад" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="КАРТОЧКА ПРОДУКТА"
            android:textColor="@color/food_muted" android:textStyle="bold" android:textSize="10sp" android:letterSpacing="0.08" android:paddingTop="4dp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" app:cardBackgroundColor="@color/food_soft" app:cardCornerRadius="18dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:gravity="center_horizontal">
                <ImageView android:id="@+id/imageDetailProduct" android:layout_width="150dp" android:layout_height="130dp"
                    android:scaleType="centerInside" android:src="@drawable/ic_package" android:background="@color/white"
                    android:contentDescription="Изображение продукта" />
                <TextView android:id="@+id/textDetailName" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Название продукта" android:textColor="@color/food_heading" android:textSize="19sp" android:textStyle="bold"
                    android:gravity="center" android:paddingTop="12dp" />
                <TextView android:id="@+id/textDetailBrand" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Бренд" android:textColor="@color/food_muted" android:textSize="11sp" android:gravity="center" android:paddingTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Пищевая ценность на 100 г"
            android:textColor="@color/food_heading" android:textSize="14sp" android:textStyle="bold" android:paddingTop="17dp" android:paddingBottom="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_marginEnd="4dp" app:cardCornerRadius="12dp" app:strokeColor="@color/food_line" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Калории" android:textColor="@color/food_muted" android:textSize="10sp" />
                    <TextView android:id="@+id/textDetailCalories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/food_heading" android:textSize="20sp" android:textStyle="bold" android:paddingTop="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ккал" android:textColor="@color/food_muted" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_marginHorizontal="4dp" app:cardCornerRadius="12dp" app:strokeColor="@color/food_line" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Белки" android:textColor="@color/food_muted" android:textSize="10sp" />
                    <TextView android:id="@+id/textDetailProtein" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/food_heading" android:textSize="20sp" android:textStyle="bold" android:paddingTop="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="г" android:textColor="@color/food_muted" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="90dp" android:layout_weight="1" android:layout_marginStart="4dp" app:cardCornerRadius="12dp" app:strokeColor="@color/food_line" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Жиры" android:textColor="@color/food_muted" android:textSize="10sp" />
                    <TextView android:id="@+id/textDetailFat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/food_heading" android:textSize="20sp" android:textStyle="bold" android:paddingTop="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="г" android:textColor="@color/food_muted" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" app:cardCornerRadius="14dp" app:strokeColor="@color/food_line" app:strokeWidth="1dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Состав"
                    android:textColor="@color/food_heading" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textDetailIngredients" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Состав не указан" android:textColor="@color/food_text_secondary" android:textSize="12sp" android:lineSpacingExtra="3dp" android:paddingTop="6dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/food_line" android:layout_marginTop="12dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Информация о продукте"
                    android:textColor="@color/food_heading" android:textSize="13sp" android:textStyle="bold" android:paddingTop="12dp" />
                <TextView android:id="@+id/textDetailInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Источник: Open Food Facts" android:textColor="@color/food_muted" android:textSize="11sp" android:paddingTop="5dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonToggleFavorite" android:layout_width="match_parent"
            android:layout_height="50dp" android:layout_marginTop="15dp" android:text="Добавить в избранное"
            android:textAllCaps="false" app:cornerRadius="12dp" />
        <TextView android:id="@+id/textDetailDisclaimer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Значения зависят от полноты данных Open Food Facts. Прочерк означает, что показатель не указан."
            android:textColor="#829287" android:textSize="10sp" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="12dp" />
    </LinearLayout>
</ScrollView>
