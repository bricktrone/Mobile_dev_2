<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="8dp" android:gravity="center_vertical">
    <ImageView android:id="@+id/imageProduct" android:layout_width="96dp" android:layout_height="80dp"
        android:scaleType="centerCrop" android:contentDescription="Изображение продукта" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/textProductName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/textProductSubtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
