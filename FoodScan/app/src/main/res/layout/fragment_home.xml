<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true" android:background="@color/food_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <include layout="@layout/fragment_app_header" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
            android:layout_height="wrap_content" app:cardBackgroundColor="@color/food_green" app:cardCornerRadius="22dp" app:cardElevation="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_food_hero">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ТВОЙ ПОМОЩНИК В МАГАЗИНЕ" android:textColor="#C4DFCE" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Что внутри продукта?" android:textColor="@color/white" android:textSize="24sp"
                    android:textStyle="bold" android:paddingTop="10dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Узнай состав, пищевую ценность и сохраняй понравившиеся товары."
                    android:textColor="#DCEBE0" android:textSize="12sp" android:lineSpacingExtra="3dp" android:paddingTop="6dp" android:paddingBottom="15dp" />
                <EditText android:id="@+id/editHomeBarcode" android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_food_input" android:hint="Введите штрихкод"
                    android:inputType="number" android:singleLine="true" android:textColor="@color/food_heading"
                    android:textColorHint="#8A9B90" android:paddingHorizontal="13dp" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonHomeFind"
                    android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp"
                    android:text="Найти продукт" android:textAllCaps="false" android:textStyle="bold"
                    android:textColor="@color/food_green" app:backgroundTint="@color/white"
                    app:cornerRadius="11dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonOpenScan"
                    android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp"
                    android:text="Открыть поиск по штрихкоду  →" android:textAllCaps="false" android:textStyle="bold"
                    android:textColor="@color/white" app:backgroundTint="#3D765B" app:cornerRadius="11dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="20dp" android:paddingBottom="10dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Возможности" android:textColor="@color/food_heading" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FoodScan" android:textColor="@color/food_green_2" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="2" android:useDefaultMargins="false">
            <com.google.android.material.card.MaterialCardView android:id="@+id/tileBarcode" android:layout_width="0dp"
                android:layout_height="105dp" android:layout_columnWeight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="9dp"
                app:cardCornerRadius="15dp" app:strokeColor="@color/food_line" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:orientation="vertical">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/bg_food_soft" android:src="@drawable/ic_barcode" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Поиск по коду" android:textColor="@color/food_heading" android:textStyle="bold" android:textSize="12sp" android:paddingTop="6dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Найди продукт по штрихкоду" android:textColor="@color/food_muted" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/tileRecognition" android:layout_width="0dp"
                android:layout_height="105dp" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:layout_marginBottom="9dp"
                app:cardCornerRadius="15dp" app:strokeColor="@color/food_line" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:orientation="vertical">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/bg_food_soft" android:src="@drawable/ic_camera" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Распознавание" android:textColor="@color/food_heading" android:textStyle="bold" android:textSize="12sp" android:paddingTop="6dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Определи продукт по фото" android:textColor="@color/food_muted" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/tileFavorites" android:layout_width="0dp"
                android:layout_height="105dp" android:layout_columnWeight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="9dp"
                app:cardCornerRadius="15dp" app:strokeColor="@color/food_line" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:orientation="vertical">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/bg_food_soft" android:src="@drawable/ic_heart" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Избранное" android:textColor="@color/food_heading" android:textStyle="bold" android:textSize="12sp" android:paddingTop="6dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сохраняй продукты" android:textColor="@color/food_muted" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/tileProfile" android:layout_width="0dp"
                android:layout_height="105dp" android:layout_columnWeight="1" android:layout_marginStart="5dp" android:layout_marginBottom="9dp"
                app:cardCornerRadius="15dp" app:strokeColor="@color/food_line" app:strokeWidth="1dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:orientation="vertical">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/bg_food_soft" android:src="@drawable/ic_user" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Профиль" android:textColor="@color/food_heading" android:textStyle="bold" android:textSize="12sp" android:paddingTop="6dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Управляй аккаунтом" android:textColor="@color/food_muted" android:textSize="9sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="9dp" android:paddingBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Каталог продуктов" android:textColor="@color/food_heading" android:textStyle="bold" android:textSize="16sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonRetryCatalog"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Обновить" android:textAllCaps="false" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/textCatalogStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Загрузка каталога Open Food Facts…" android:textColor="@color/food_muted" android:textSize="11sp" android:paddingBottom="8dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerProducts"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"
            android:clipToPadding="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Данные каталога загружаются из Open Food Facts. Избранное хранится локально с помощью Room."
            android:textColor="#829287" android:textSize="10sp" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
