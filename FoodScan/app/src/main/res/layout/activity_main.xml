<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/textProfile" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Режим гостя" android:textStyle="bold"
        android:textSize="18sp" android:padding="8dp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/buttonAccount" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Войти" />
            <Button android:id="@+id/buttonFavorites" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Избранное" />
            <Button android:id="@+id/buttonBarcode" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Штрихкод" />
            <Button android:id="@+id/buttonRecognize" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Распознать" />
        </LinearLayout>
    </HorizontalScrollView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Каталог продуктов" android:textStyle="bold" android:textSize="20sp"
        android:paddingTop="8dp" android:paddingBottom="8dp" />
    <TextView android:id="@+id/textDataSources" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Каталог из NetworkApi и избранное из Room"
        android:textSize="12sp" android:paddingTop="4dp" android:paddingBottom="4dp" />
    <ListView android:id="@+id/listProducts" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:dividerHeight="8dp" />
</LinearLayout>
