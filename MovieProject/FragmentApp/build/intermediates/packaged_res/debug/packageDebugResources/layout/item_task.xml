<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardCornerRadius="16dp" app:cardElevation="1dp"
    app:strokeColor="#DCE7DE" app:strokeWidth="1dp" app:cardBackgroundColor="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/textTaskTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#204A39" android:textStyle="bold" android:textSize="16sp" />
        <TextView android:id="@+id/textTaskStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#668171" android:textSize="12sp"
            android:paddingTop="4dp" />
        <CheckBox android:id="@+id/checkTaskDone" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Отметить выполненным"
            android:textColor="#215A45" android:buttonTint="#287451" android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
