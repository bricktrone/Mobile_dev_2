<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="24dp" android:background="#FFFFFF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Полученные данные" android:textColor="#204A39" android:textSize="21sp" android:textStyle="bold" />
    <TextView android:id="@+id/textReceivedData" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ожидание сообщения…" android:textColor="#668171" android:textSize="16sp" android:paddingTop="16dp" android:paddingBottom="12dp" />
</LinearLayout>
