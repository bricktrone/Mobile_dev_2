<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/textHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/profile_message" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/textDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/profile_description" android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
